#version 450
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;

// Port of Rogue's propogate_light.comp: radiance from visible surface
// points, stored on the same 0.2-unit uniform 3D probe lattice.
layout(rgba16f,set=0,binding=0) writeonly uniform image3D grid;
struct CloudPoint {
    vec4 position;
    vec4 normal;
    vec4 radiance;
};
layout(std430,set=0,binding=1) readonly buffer Points { CloudPoint points[]; };
layout(std430,set=0,binding=2) readonly buffer Geometry { vec4 vertices[]; };
struct ShadowNode {
    vec4 minimum;
    vec4 maximum;
    uvec4 info; // next node after subtree, first triangle, triangle count
};
layout(std430,set=0,binding=3) readonly buffer ShadowTree { ShadowNode nodes[]; };
layout(push_constant) uniform Settings {
    uint point_count;
    uint vertex_count;
    uint node_count;
    uint padding;
    vec4 grid_origin_spacing;
} pc;

bool triangle_hit(vec3 origin,vec3 ray,float far_distance,vec3 a,vec3 b,vec3 c)
{
    vec3 e1=b-a,e2=c-a;
    vec3 p=cross(ray,e2);
    float det=dot(e1,p);
    if(det<=0.00001)return false; // Legacy: ignore back faces.
    float inverse=1.0/det;
    vec3 t=origin-a;
    float u=dot(t,p)*inverse;
    if(u<0.0 || u>1.0)return false;
    vec3 q=cross(t,e1);
    float v=dot(ray,q)*inverse;
    if(v<0.0 || u+v>1.0)return false;
    float distance=dot(e2,q)*inverse;
    return distance>0.001 && distance<far_distance;
}
bool shadow_box(vec3 origin,vec3 direction,float distance,ShadowNode node)
{
    vec3 safe=vec3(
        abs(direction.x)<1e-7?(direction.x<0.0?-1e-7:1e-7):direction.x,
        abs(direction.y)<1e-7?(direction.y<0.0?-1e-7:1e-7):direction.y,
        abs(direction.z)<1e-7?(direction.z<0.0?-1e-7:1e-7):direction.z);
    vec3 p=(node.minimum.xyz-origin)/safe;
    vec3 q=(node.maximum.xyz-origin)/safe;
    vec3 lo=min(p,q),hi=max(p,q);
    float t0=max(max(lo.x,lo.y),max(lo.z,0.0));
    float t1=min(min(hi.x,hi.y),min(hi.z,distance));
    return t0<=t1;
}

bool any_hit(vec3 origin,vec3 ray,float distance)
{
    uint total=min(pc.node_count,uint(nodes.length()));
    uint vertex_count=min(pc.vertex_count,uint(vertices.length()));
    uint index=0u;
    while(index<total)
    {
        ShadowNode node=nodes[index];
        if(!shadow_box(origin,ray,distance,node))
        {
            index=max(node.info.x,index+1u);
            continue;
        }
        if(node.info.z>0u)
        {
            uint first=node.info.y, end=min(first+node.info.z,vertex_count/3u);
            for(uint i=first;i<end;++i)
            {
                uint v=i*3u;
                if(triangle_hit(origin,ray,distance,
                    vertices[v].xyz,vertices[v+1u].xyz,vertices[v+2u].xyz))
                    return true;
            }
        }
        ++index;
    }
    return false;
}
void main()
{
    ivec3 cell=ivec3(gl_GlobalInvocationID.xyz);
    if(any(greaterThanEqual(cell,imageSize(grid))))return;
    vec3 position=pc.grid_origin_spacing.xyz+
                  vec3(cell)*pc.grid_origin_spacing.w;
    vec3 indirect=vec3(0.0);
    const float max_distance=2.6; // Rogue's original probe range
    for(uint i=0u;i<pc.point_count;++i)
    {
        vec3 value=points[i].radiance.rgb;
        if(dot(value,value)<=0.0)continue;
        vec3 delta=position-points[i].position.xyz;
        float distance=length(delta);
        if(distance<=0.02 || distance>=max_distance)continue;
        vec3 ray=delta/distance;
        if(dot(points[i].normal.xyz,ray)<=0.0)continue;
        if(!any_hit(points[i].position.xyz+ray*0.003,ray,distance-0.006))
            indirect+=value/distance;
    }
    imageStore(grid,cell,vec4(indirect/40.0,1.0));
}
