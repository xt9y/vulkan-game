#version 450
layout(local_size_x=64) in;

// Port of Rogue's point_cloud.comp: surface samples and triangle visibility.
struct CloudPoint {
    vec4 position;
    vec4 normal;
    vec4 radiance;
};
struct Light {
    vec4 position_range;
    vec4 color_intensity;
};
layout(std430,set=0,binding=0) buffer Points { CloudPoint points[]; };
layout(std430,set=0,binding=1) readonly buffer Geometry { vec4 vertices[]; };
layout(std430,set=0,binding=2) readonly buffer Lights { Light lights[]; };
layout(push_constant) uniform Counts {
    uint point_count;
    uint vertex_count;
    uint light_count;
    uint padding;
} pc;

bool triangle_hit(vec3 origin,vec3 ray,float far_distance,vec3 a,vec3 b,vec3 c)
{
    vec3 e1=b-a,e2=c-a;
    vec3 p=cross(ray,e2);
    float det=dot(e1,p);
    if(abs(det)<0.00001)return false;
    float inverse=1.0/det;
    vec3 t=origin-a;
    float u=dot(t,p)*inverse;
    if(u<0.0 || u>1.0)return false;
    vec3 q=cross(t,e1);
    float v=dot(ray,q)*inverse;
    if(v<0.0 || u+v>1.0)return false;
    float distance=dot(e2,q)*inverse;
    return distance>0.001 && distance<far_distance;
}

bool any_hit(vec3 origin,vec3 ray,float far_distance)
{
    for(uint i=0u;i+2u<pc.vertex_count;i+=3u)
        if(triangle_hit(origin,ray,far_distance,
                        vertices[i].xyz,vertices[i+1].xyz,vertices[i+2].xyz))
            return true;
    return false;
}

void main()
{
    uint id=gl_GlobalInvocationID.x;
    if(id>=pc.point_count)return;
    vec3 origin=points[id].position.xyz;
    vec3 normal=normalize(points[id].normal.xyz);
    vec3 color=vec3(0.0);
    for(uint i=0u;i<pc.light_count;++i)
    {
        vec3 to_light=lights[i].position_range.xyz-origin;
        float distance=length(to_light);
        float radius=lights[i].position_range.w;
        if(distance<0.002 || distance>=radius)continue;
        vec3 direction=to_light/distance;
        float ndotl=max(dot(normal,direction),0.0);
        if(ndotl<=0.0)continue;
        float q=clamp(distance/radius,0.0,1.0);
        float attenuation=1.0-q*q*(3.0-2.0*q);
        if(!any_hit(origin+normal*0.004,direction,distance-0.008))
            color+=lights[i].color_intensity.rgb*
                   lights[i].color_intensity.w*attenuation*ndotl;
    }
    points[id].radiance=vec4(color,1.0);
}
