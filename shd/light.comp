#version 450
layout(local_size_x=8,local_size_y=8) in;

layout(set=0,binding=0) uniform sampler2D g_albedo;
layout(set=0,binding=1) uniform sampler2D g_normal;
layout(set=0,binding=2) uniform sampler2D g_material;
layout(set=0,binding=3) uniform sampler2D g_depth;
layout(set=0,binding=4) uniform sampler2D indirect_shadow;
layout(rgba16f,set=0,binding=5) writeonly uniform image2D hdr;

struct PointLight {
    vec4 position_range;
    vec4 color_intensity;
};
layout(std430,set=0,binding=6) readonly buffer Lights {
    PointLight lights[];
};

layout(push_constant) uniform Controls {
    float exposure;
    float reserved0;
    vec2 reserved1;
    vec4 eye_near;
    vec4 forward_far;
    vec4 right_tan;
    vec4 up_tan;
    vec4 light_count;
    vec4 sky;
} pc;

const float PI=3.14159265359;

vec3 fresnel(float cos_theta,vec3 f0)
{
    return f0+(1.0-f0)*pow(1.0-cos_theta,5.0);
}

vec3 brdf(vec3 albedo,float metallic,float roughness,
          vec3 N,vec3 V,vec3 L)
{
    float nl=max(dot(N,L),0.0);
    if(nl<=0.0)return vec3(0.0);
    vec3 H=normalize(V+L);
    float nv=max(dot(N,V),1e-4);
    float nh=max(dot(N,H),0.0);
    float vh=max(dot(V,H),0.0);
    float a=roughness*roughness;
    float a2=a*a;
    float d=nh*nh*(a2-1.0)+1.0;
    float D=a2/max(PI*d*d,1e-6);
    float k=(roughness+1.0)*(roughness+1.0)*0.125;
    float G=(nv/(nv*(1.0-k)+k))*(nl/(nl*(1.0-k)+k));
    vec3 F=fresnel(vh,mix(vec3(0.04),albedo,metallic));
    vec3 specular=D*G*F/max(4.0*nv*nl,1e-4);
    vec3 diffuse=(1.0-F)*(1.0-metallic)*albedo/PI;
    return (diffuse+specular)*nl;
}

float linear_depth(float depth)
{
    float n=pc.eye_near.w,f=pc.forward_far.w;
    // The scene render pass maps world depth into the 0.1..1.0 viewport.
    float d=clamp((depth-0.1)/0.9,0.0,1.0);
    return n*f/max(f-d*(f-n),1e-6);
}

vec3 world_position(ivec2 pixel,ivec2 extent,float depth)
{
    vec2 ndc=(vec2(pixel)+0.5)/vec2(extent)*2.0-1.0;
    vec3 direction=pc.forward_far.xyz+
        ndc.x*pc.right_tan.xyz*pc.right_tan.w-
        ndc.y*pc.up_tan.xyz*pc.up_tan.w;
    return pc.eye_near.xyz+direction*linear_depth(depth);
}

vec4 filtered_indirect(ivec2 pixel,vec3 normal,float depth)
{
    ivec2 size=textureSize(indirect_shadow,0);
    ivec2 full=textureSize(g_depth,0);
    vec2 pos=(vec2(pixel)+0.5)*0.5-0.5;
    ivec2 base=ivec2(floor(pos));
    vec2 t=fract(pos);
    vec4 sum=vec4(0.0);
    float weight_sum=0.0;
    for(int y=0;y<2;++y)
    for(int x=0;x<2;++x)
    {
        ivec2 c=clamp(base+ivec2(x,y),ivec2(0),size-1);
        ivec2 source=min(c*2+ivec2(1),full-1);
        float neighbor_depth=texelFetch(g_depth,source,0).r;
        if(neighbor_depth>=0.999999 || neighbor_depth<0.1)continue;
        vec3 neighbor_normal=normalize(
            texelFetch(g_normal,source,0).rgb*2.0-1.0);
        float bilateral=exp(-abs(linear_depth(depth)-
                     linear_depth(neighbor_depth))*2.0)*
                     pow(max(dot(normal,neighbor_normal),0.0),8.0);
        float bilinear=(x==0?1.0-t.x:t.x)*(y==0?1.0-t.y:t.y);
        float weight=bilateral*bilinear;
        sum+=texelFetch(indirect_shadow,c,0)*weight;
        weight_sum+=weight;
    }
    if(weight_sum>1e-5)return sum/weight_sum;
    return texelFetch(indirect_shadow,clamp(pixel/2,ivec2(0),size-1),0);
}

void main()
{
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(hdr);
    if(any(greaterThanEqual(p,size)))return;

    float depth=texelFetch(g_depth,p,0).r;
    if(depth>=0.999999)
    {
        imageStore(hdr,p,vec4(pc.sky.rgb,1.0));
        return;
    }
    vec4 a=texelFetch(g_albedo,p,0);
    vec4 n=texelFetch(g_normal,p,0);
    vec4 m=texelFetch(g_material,p,0);
    vec3 N=normalize(n.rgb*2.0-1.0);
    bool viewmodel=depth<0.1;
    vec3 P=viewmodel
        ? pc.eye_near.xyz+normalize(world_position(p,size,0.18)-pc.eye_near.xyz)*0.5
        : world_position(p,size,depth);
    vec3 V=normalize(pc.eye_near.xyz-P);
    float roughness=clamp(m.r,0.045,1.0);
    float metallic=clamp(m.g,0.0,1.0);
    float ao=clamp(m.b,0.0,1.0);

    vec4 bounce_shadow=viewmodel?vec4(0.0,0.0,0.0,1.0)
                                  :filtered_indirect(p,N,depth);
    vec3 color=vec3(0.0);

    uint count=min(min(uint(max(pc.light_count.x,0.0)),
                       uint(lights.length())),64u);
    // Viewmodel receives nearby point lights, but no screen-space world GI.
    for(uint i=0u;i<count;++i)
    {
        vec3 delta=lights[i].position_range.xyz-P;
        float d2=dot(delta,delta);
        float range=max(lights[i].position_range.w,0.001);
        float d=sqrt(d2);
        if(d>=range || d<1e-4)continue;
        // Hell-style radius falloff, defined without reversed smoothstep edges.
        float q=clamp(d/range,0.0,1.0);
        float attenuation=1.0-q*q*(3.0-2.0*q);
        color+=brdf(a.rgb,metallic,roughness,N,V,delta/d)*
               lights[i].color_intensity.rgb*
               (lights[i].color_intensity.w*attenuation);
    }
    color+=a.rgb*(1.0-metallic)*ao*
           max(bounce_shadow.rgb,vec3(0.0))/PI;
    vec3 packed=vec3(a.a,n.a,m.a);
    color+=packed/max(vec3(1.0)-packed,vec3(1.0/255.0));
    imageStore(hdr,p,vec4(max(color,vec3(0.0)),1.0));
}
