#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set=0,binding=0) uniform sampler2D g_albedo;
layout(set=0,binding=1) uniform sampler2D g_normal;
layout(set=0,binding=2) uniform sampler2D g_material;
layout(set=0,binding=3) uniform sampler2D g_depth;
layout(rgba16f, set=0,binding=4) writeonly uniform image2D hdr;
layout(push_constant) uniform Controls { int enabled; float exposure; } pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdr);
    if (any(greaterThanEqual(p, size))) return;
    float depth = texelFetch(g_depth, p, 0).r;
    if (depth >= 0.999999)
    {
        imageStore(hdr, p, vec4(0.035, 0.045, 0.065, 1.0));
        return;
    }
    vec3 albedo = texelFetch(g_albedo, p, 0).rgb;
    vec3 normal = normalize(texelFetch(g_normal, p, 0).xyz * 2.0 - 1.0);
    vec4 material = texelFetch(g_material, p, 0);
    vec3 direction = normalize(vec3(0.5, 1.0, 0.3));
    float diffuse = max(dot(normal, direction), 0.0);
    float roughness = material.r;
    float ambient = 0.25;
    vec3 color = pc.enabled != 0 ?
        albedo * (ambient + 0.75 * diffuse) * (1.0 - 0.1 * roughness) : albedo;
    imageStore(hdr, p, vec4(color, 1.0));
}
