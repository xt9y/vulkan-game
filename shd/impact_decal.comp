#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D g_depth;
layout(set = 0, binding = 1) uniform sampler2D g_normal;
layout(set = 0, binding = 2) uniform sampler2D decal0;
layout(set = 0, binding = 3) uniform sampler2D decal1;
layout(set = 0, binding = 4) uniform sampler2D decal2;
layout(set = 0, binding = 5) uniform sampler2D decal3;
layout(set = 0, binding = 6) uniform sampler2D decal4;
layout(rgba8, set = 0, binding = 7) writeonly uniform image2D overlay;

struct Decal
{
    mat4 world_to_local;
    vec4 normal;
    vec4 tint;
};

layout(std430, set = 0, binding = 8) readonly buffer Decals
{
    Decal decals[];
};

layout(std430, set = 0, binding = 9) readonly buffer TileCounts
{
    uint tile_counts[];
};

layout(std430, set = 0, binding = 10) readonly buffer TileIndices
{
    uint tile_indices[];
};

layout(push_constant) uniform Push
{
    mat4 inverse_view_projection;
    uint width;
    uint height;
    uint decal_count;
    float depth_min;
} pc;

vec4 sample_decal(uint variant, vec2 uv)
{
    if (variant == 0u) return textureLod(decal0, uv, 0.0);
    if (variant == 1u) return textureLod(decal1, uv, 0.0);
    if (variant == 2u) return textureLod(decal2, uv, 0.0);
    if (variant == 3u) return textureLod(decal3, uv, 0.0);
    return textureLod(decal4, uv, 0.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height)) return;

    float depth = texelFetch(g_depth, pixel, 0).r;
    if (depth < pc.depth_min || depth >= .999999 || pc.decal_count == 0u)
    {
        imageStore(overlay, pixel, vec4(0));
        return;
    }

    vec2 uv = (vec2(pixel) + .5) / vec2(pc.width, pc.height);
    vec4 clip = vec4(
        uv * 2.0 - 1.0,
        (depth - pc.depth_min) / (1.0 - pc.depth_min),
        1.0
    );
    vec4 position = pc.inverse_view_projection * clip;
    if (abs(position.w) < 1e-8)
    {
        imageStore(overlay, pixel, vec4(0));
        return;
    }
    vec3 world = position.xyz / position.w;
    vec3 normal = normalize(texelFetch(g_normal, pixel, 0).xyz * 2.0 - 1.0);

    const uint tile_size = 16u;
    const uint capacity = 64u;
    uint columns = (pc.width + tile_size - 1u) / tile_size;
    uint tile = (uint(pixel.y) / tile_size) * columns +
                (uint(pixel.x) / tile_size);
    uint count = min(tile_counts[tile], capacity);

    vec4 result = vec4(0);

    for (uint i = 0u; i < count; ++i)
    {
        uint index = tile_indices[tile * capacity + i];
        if (index >= pc.decal_count) continue;
        Decal decal = decals[index];

        vec3 local = (decal.world_to_local * vec4(world, 1.0)).xyz;
        if (abs(local.x) > .5 || abs(local.y) > .5 || abs(local.z) > .18)
            continue;
        if (dot(normal, normalize(decal.normal.xyz)) < .2)
            continue;

        vec2 decal_uv = local.xy + .5;
        vec4 shape = sample_decal(uint(decal.normal.w + .5), decal_uv);
        float alpha = clamp(shape.a * decal.tint.a, 0.0, 1.0);
        if (alpha < .002) continue;

        vec3 pigment = pow(max(shape.rgb, vec3(0)), vec3(2.2)) *
                       decal.tint.rgb;
        float total = alpha + result.a * (1.0 - alpha);
        result.rgb = total > 1e-5
            ? (pigment * alpha + result.rgb * result.a * (1.0 - alpha)) / total
            : vec3(0);
        result.a = total;
    }

    imageStore(overlay, pixel, result);
}
